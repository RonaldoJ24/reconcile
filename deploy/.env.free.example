# Configuration contract for Codex to implement; no application code is included.
# Never fill credentials into tracked files or frontend VITE_* variables.
RECONCILE_PROFILE=free_preview
RECONCILE_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
RECONCILE_ALLOW_LIVE_PROVIDER=false
RECONCILE_PROVIDER_ACCESS=invite_only
RECONCILE_THINKING=disabled
RECONCILE_LLM_INPUT_TOKEN_LIMIT=6000
RECONCILE_LLM_OUTPUT_TOKEN_LIMIT=2048
RECONCILE_LLM_CONCURRENCY=1
RECONCILE_LLM_MAX_ATTEMPTS=2
RECONCILE_LLM_ATTEMPT_TIMEOUT_SECONDS=20
RECONCILE_LLM_TOTAL_TIMEOUT_SECONDS=45
# Proposed app safety ceilings; not automatic spending or top-up authorization.
RECONCILE_LLM_DAILY_USD_LIMIT=0.10
RECONCILE_LLM_MONTHLY_USD_LIMIT=1.00
RECONCILE_LLM_SESSION_REQUEST_LIMIT=5
RECONCILE_LLM_GLOBAL_DAILY_ATTEMPT_LIMIT=25
RECONCILE_MAX_FILE_BYTES=1048576
RECONCILE_MAX_BATCH_BYTES=4194304
RECONCILE_MAX_WORKSPACE_SOURCE_BYTES=5242880
RECONCILE_MAX_TOTAL_SOURCE_BYTES=52428800
RECONCILE_MAX_DATABASE_BYTES=314572800
RECONCILE_SYNTHETIC_SESSION_TTL_HOURS=24
RECONCILE_WORKER_MODE=web_lifecycle
RECONCILE_DB_POOL_SIZE=2
RECONCILE_DB_MAX_OVERFLOW=0
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
