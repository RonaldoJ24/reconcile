# Reconcile Free preview configuration. Never commit filled credentials.
RECONCILE_MODE=preview
RECONCILE_RANKER_MODE=shadow
RECONCILE_WORKER_MODE=web_lifecycle

# Use a pooled Neon URL at runtime and a direct URL only for guarded migrations.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Leave public access and live calls disabled until a server credential and
# a nonzero, explicitly authorized execution budget are configured.
# Public access is a reversible preview flag; invitation access remains available.
RECONCILE_PUBLIC_PROVIDER_ACCESS=0
# Public preview defaults; approved ceilings are USD 0.50/day and USD 5/month.
RECONCILE_LLM_DAILY_BUDGET_USD=0.10
RECONCILE_LLM_MONTHLY_BUDGET_USD=1.00
RECONCILE_LLM_ENABLED=0
RECONCILE_LLM_MODEL=deepseek-flash
RECONCILE_LLM_EXECUTION_ID=
RECONCILE_LLM_EXECUTION_BUDGET_USD=0
RECONCILE_PROVIDER_INVITE_SHA256=
DEEPSEEK_API_KEY=

RECONCILE_MAX_DATABASE_BYTES=314572800
RECONCILE_SYNTHETIC_SESSION_TTL_HOURS=24
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
